# Production allowlist: files outside these paths never enter the build context.
**
!Dockerfile
!.dockerignore
!requirements.txt
!main.py
!database.py
!routes/
!routes/**
!templates/
!templates/**
!static/
!static/**

# Deny sensitive/development files even inside an allowed directory.
**/.env
**/.env.*
**/.flask_secret_key
**/.git
**/.venv
**/venv
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.idea
**/.vscode
**/.aws
**/.codex
**/.agents
**/node_modules
**/secrets
**/credentials*.json
**/client_secret*.json
**/*token*.json
**/*secret*.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa
**/id_ed25519
**/*.sql
**/*.dump
**/*.bak
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.log
**/*.pyc
**/*.pyo
**/test_*.py
**/*_test.py
**/tests
**/*.tmp
**/*.temp
